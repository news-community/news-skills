# Copy to .env.local (gitignored) and fill in. Nothing here is read from .env.example itself.

# Your own API key for the newsroom below. Create one at <newsroom>/profile/settings
# and TICK "READ-ONLY": nothing in this toolkit writes, and a read-only key makes that
# a server guarantee rather than a promise in code you would have to read.
# (The one exception is `rag`, whose read-only query is an HTTP POST, so a read-only
# key refuses it.)
NEWS_DESK_API_KEY=cn_your_key_here

# Which newsroom to point at. Optional: defaults to https://alaskanews.com, which is
# the only newsroom live on this platform today. The API base is derived from this.
# NEWS_SITE=https://alaskanews.com

# Default value for --community. Optional: defaults to alaska-news.
# Run `news_desk.py communities` to see which slugs exist.
# NEWS_COMMUNITY=alaska-news

# Override the API base outright. Only needed if the API is not at <NEWS_SITE>/api/v1,
# e.g. pointing at a platform running locally.
# PLATFORM_API_BASE=http://localhost:3200/api/v1
